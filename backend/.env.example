DESKPILOT_DATABASE_URL=sqlite+aiosqlite:///./data/deskpilot.db
DESKPILOT_ARTIFACT_WORKSPACE_ROOT=./data/task-workspaces
# 可选；不设置时自动寻找 Edge/Chrome/Chromium。
# DESKPILOT_BROWSER_EXECUTABLE_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
DESKPILOT_FAKE_STEP_DELAY_SECONDS=0.15
# 可选；不设置时每次 API 启动自动生成随机会话令牌。
# DESKPILOT_SESSION_TOKEN=replace-with-at-least-32-random-characters
DESKPILOT_OUTBOX_POLL_INTERVAL_SECONDS=0.05
DESKPILOT_OUTBOX_BATCH_SIZE=100
DESKPILOT_OUTBOX_RETRY_BASE_SECONDS=0.25
DESKPILOT_OUTBOX_RETRY_MAX_SECONDS=30.0
DESKPILOT_RUNNER_HEARTBEAT_INTERVAL_SECONDS=0.5
DESKPILOT_RUNNER_HEARTBEAT_TIMEOUT_SECONDS=3.0
DESKPILOT_RUNNER_STARTUP_TIMEOUT_SECONDS=10.0
DESKPILOT_RUNNER_SHUTDOWN_TIMEOUT_SECONDS=2.0
DESKPILOT_RUNNER_RESTART_BASE_DELAY_SECONDS=0.25
DESKPILOT_RUNNER_RESTART_MAX_DELAY_SECONDS=10.0
DESKPILOT_RUNNER_CIRCUIT_FAILURE_THRESHOLD=3
DESKPILOT_RUNNER_CIRCUIT_RECOVERY_TIMEOUT_SECONDS=30.0
DESKPILOT_RUNNER_STABLE_WINDOW_SECONDS=10.0
# Windows 生产默认强制：每次调用使用受限令牌、低完整性和独立 Job Object。
DESKPILOT_RUNNER_REQUIRE_WINDOWS_SANDBOX=true
DESKPILOT_RUNNER_REQUIRE_NETWORK_ISOLATION=true
DESKPILOT_RUNNER_WORKER_RUNTIME_ROOT=./data/worker-runtime
DESKPILOT_RUNNER_APPCONTAINER_PROFILE_JOURNAL_PATH=./data/runner/appcontainer-profiles.json
DESKPILOT_RUNNER_COMMIT_RECEIPT_DATABASE_PATH=./data/runner/commit-receipts.db
# 每个调用进程的内存与活动进程硬上限；1 表示禁止派生子进程。
DESKPILOT_RUNNER_WORKER_MEMORY_LIMIT_BYTES=268435456
DESKPILOT_RUNNER_WORKER_ACTIVE_PROCESS_LIMIT=1
# 生产默认自动允许满足全部约束的 R0；仅在本地验收审批卡时改为 true。
DESKPILOT_POLICY_REQUIRE_APPROVAL_FOR_R0=false
# 一次性审批有效期，允许范围 10～3600 秒。
DESKPILOT_POLICY_APPROVAL_TTL_SECONDS=300
# Fake Planner 当前会让真实 Runner 查询该路径所在磁盘的容量元数据。
DESKPILOT_DISK_USAGE_PATH=.
DESKPILOT_MODEL_DEFAULT_PROVIDER_ID=fake-local
DESKPILOT_FAKE_MODEL_PROVIDER_ID=fake-local
DESKPILOT_FAKE_MODEL_NAME=deskpilot-fake-v1
DESKPILOT_FAKE_MODEL_DELAY_SECONDS=0
DESKPILOT_MODEL_REQUEST_TIMEOUT_SECONDS=10
# 角色路由、价格、重试预算、EWMA 与熔断策略；值必须是单行 JSON。
# 默认最多 2 次尝试、累计等待 2 秒，不设置费用上限。
# DESKPILOT_MODEL_GATEWAY_POLICY={"role_routes":[{"role":"intent","provider_ids":["fake-local"],"strategy":"priority"}],"provider_pricing":[{"provider_id":"fake-local","input_micros_per_million_tokens":0,"output_micros_per_million_tokens":0}],"default_max_attempts":2,"default_retry_delay_budget_seconds":2,"default_task_cost_budget_micros":null,"latency_ewma_alpha":0.2,"circuit_failure_threshold":3,"circuit_recovery_timeout_seconds":30}
DESKPILOT_MODEL_HEALTH_CACHE_TTL_SECONDS=15
DESKPILOT_MODEL_HEALTH_MAX_CONCURRENCY=4
DESKPILOT_MODEL_HEALTH_PROBE_TIMEOUT_SECONDS=5
# 默认关闭。启用时必须配置 SearchProvider，并为有限费用预算配置 Provider pricing。
DESKPILOT_RESEARCH_RUNTIME_ENABLED=false
# DESKPILOT_RESEARCH_SEARCH_BASE_URL=https://search.example.test

# 多 Provider 配置。未设置时继续使用上面的 legacy Fake Provider 配置。
# JSON 中只能保存 credential_ref，禁止保存 api_key 明文。
# 本地 Ollama/OpenAI-compatible 示例：
# DESKPILOT_MODEL_PROVIDERS=[{"kind":"fake","provider_id":"fake-local"},{"kind":"openai_compatible_chat","provider_id":"ollama-local","display_name":"Local Ollama","model":"your-local-model","base_url":"http://127.0.0.1:11434/v1","location":"local"}]
# 云端 Provider 可以使用 environment backend：
# "credential_ref":{"backend":"environment","identifier":"DESKPILOT_CREDENTIAL_CLOUD_CHAT"}
# 密钥必须在启动进程环境中设置，不要写入本文件或提交到仓库：
# $env:DESKPILOT_CREDENTIAL_CLOUD_CHAT="replace-with-real-secret"
# Windows 桌面环境推荐先用隐藏输入 CLI 保存密钥：
# .\.venv\Scripts\python.exe -m deskpilot.credential_cli store CLOUD_CHAT
# 然后在 Provider JSON 中引用：
# "credential_ref":{"backend":"windows_credential_manager","identifier":"CLOUD_CHAT"}
# Database-backed Tool effect graph ownership lease.
DESKPILOT_GRAPH_LEASE_TTL_SECONDS=15
# Process-wide DAG admission limits and bounded ready-proof page size.
DESKPILOT_EFFECT_DAG_GLOBAL_CONCURRENCY=8
DESKPILOT_EFFECT_DAG_GRAPH_CONCURRENCY=4
DESKPILOT_EFFECT_DAG_TOOL_CONCURRENCY=4
DESKPILOT_EFFECT_DAG_READY_PAGE_SIZE=64
# Database-backed DAG admission lease and scheduler polling bounds.
DESKPILOT_EFFECT_DAG_ADMISSION_LEASE_TTL_SECONDS=15
DESKPILOT_EFFECT_DAG_ADMISSION_POLL_INTERVAL_SECONDS=0.05
# Durable cross-API graph control polling, delivery claim, and request wait bounds.
DESKPILOT_EFFECT_GRAPH_CONTROL_POLL_INTERVAL_SECONDS=0.05
DESKPILOT_EFFECT_GRAPH_CONTROL_CLAIM_TTL_SECONDS=15
DESKPILOT_EFFECT_GRAPH_CONTROL_REQUEST_TIMEOUT_SECONDS=30
# Database-backed Outbox claim TTL; stale publishers cannot acknowledge a new fence.
DESKPILOT_OUTBOX_CLAIM_TTL_SECONDS=15
DESKPILOT_OUTBOX_MAX_ATTEMPTS=8
# 默认 local 直接扇出；仅显式选择 rabbitmq 时才连接外部 broker。
DESKPILOT_EVENT_TRANSPORT=local
# DESKPILOT_RABBITMQ_URL=amqp://deskpilot:secret@127.0.0.1:5672/deskpilot_test
DESKPILOT_RABBITMQ_EXCHANGE=deskpilot.events.v1
DESKPILOT_RABBITMQ_QUEUE=deskpilot.task-events.websocket.v1
DESKPILOT_RABBITMQ_ROUTING_KEY=task.event
DESKPILOT_RABBITMQ_PREFETCH_COUNT=32
DESKPILOT_RABBITMQ_CONNECTION_TIMEOUT_SECONDS=10
DESKPILOT_RABBITMQ_PUBLISH_TIMEOUT_SECONDS=10
# Protected operations metrics audit and bounded retention scheduler.
DESKPILOT_OPERATIONS_RETENTION_DAYS=30
DESKPILOT_OPERATIONS_RETENTION_INTERVAL_SECONDS=3600
DESKPILOT_OPERATIONS_METRICS_INTERVAL_SECONDS=300
DESKPILOT_OPERATIONS_RETENTION_BATCH_SIZE=1000
DESKPILOT_OPERATIONS_STALLED_AFTER_SECONDS=60
